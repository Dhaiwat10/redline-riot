{
  "name": "redline-riot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @rr/client --filter @rr/server dev",
    "build": "pnpm --filter @rr/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:lag": "SIM_LAG_MS=150 SIM_JITTER_MS=30 pnpm dev",
    "start": "pnpm build && STATIC_DIR=../client/dist pnpm --filter @rr/server start",
    "deploy": "fly deploy --ha=false"
  },
  "packageManager": "pnpm@9.12.0",
  "license": "MIT"
}
